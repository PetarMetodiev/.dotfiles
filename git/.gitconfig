[user]
	name = Petar Metodiev
	email = petar.metodiev@gmail.com
[credential]
	helper = cache --timeout=172800 # Remember credentials for 48 hours.
[core]
	pager = diff-so-fancy | less --tabs=4 -RXS
	editor = nvim
[color]
	# Use colors in the terminal and pager, but not redirected output.
	ui = auto
[color "diff"]
	meta = yellow bold
	commit = green bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = "red bold 52"
	newNormal = "green bold"
	newHighlight = "green bold 22"
[color "branch"]
    remote = yellow
[alias]
	aliases = config --get-regexp alias
	tree = log --pretty=format:\"%C(cyan)|%h| %cr%Creset %C(yellow)%an:%Creset %C(magenta)%d%Creset %s\" --graph --color --all
	iadd = add -i
[http]
	sslVerify = true
[rerere]
  # Remember conflict resolutions and reuse them when the same conflicts recur.
  enabled = true
  # Leave reused resolutions unstaged so they can be reviewed before git add.
  autoUpdate = false
[fetch]
  # Remove remote-tracking branches deleted on the remote; keep local branches.
  prune = true
[merge]
  # Show the common ancestor in conflicts, trimming redundant context.
  conflictStyle = zdiff3
[push]
  # Set the upstream on the first default push when the branch has none.
  autoSetupRemote = true
